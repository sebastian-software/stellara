{
  "name": "stellara",
  "version": "0.1.15",
  "private": true,
  "license": "MIT",
  "description": "Stellara — AI Tool Gateway for Firecrawl, Exa, Qdrant, ChatGPT and Claude",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b ./tsconfig.src.json --force",
    "start": "node dist/server.js",
    "typecheck": "tsc -b",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint --fix . && eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "agent:check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "migrate:embeddings": "tsx scripts/migrate-embeddings.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.8.1",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^6.1.0",
    "graphql": "^17.0.2",
    "jose": "^6.2.10",
    "pino": "^10.3.1",
    "playwright": "^1.62.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "ulid": "^3.0.2",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.5",
    "eslint": "^10.9.1",
    "eslint-config-setup": "^0.5.2",
    "oxlint": "^1.80.0",
    "prettier": "^3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
