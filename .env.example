# --- Runtime ---
NODE_ENV=production
# Keep PORT aligned with docker/Dockerfile, docker-compose.yml, and the
# forwarding port configured on the edge or reverse proxy.
PORT=8787

# The public HTTPS origin clients use to reach Stellara. OAuth discovery URLs
# and the JWT `iss` claim are derived from this value.
PUBLIC_BASE_URL=https://stellara.example.com

# Name of the existing external Docker network connected to the edge or reverse proxy.
STELLARA_PROXY_NETWORK=proxy-network

# --- User tokens ---
STELLARA_TOKEN_USER_A=
STELLARA_TOKEN_USER_B=
# Add users as STELLARA_TOKEN_<USERID>=

# --- Firecrawl (required) ---
FIRECRAWL_BASE_URL=
FIRECRAWL_API_KEY=

# --- Exa (optional) ---
EXA_API_KEY=

# --- Qdrant (optional) ---
QDRANT_BASE_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=stellara-memory

# --- Embeddings (required when Qdrant is enabled) ---
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_API_KEY=
EMBEDDINGS_DIMENSIONS=1536

# --- Logging and timeouts ---
LOG_LEVEL=info
# Global ceiling; it must be at least as large as the longest per-tool timeout.
REQUEST_TIMEOUT_MS=90000

# --- Rate limiting per token ---
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# --- Trusted proxy boundary ---
# Comma-separated CIDRs of direct TCP peers whose forwarding headers Stellara
# may trust. Add only direct, controlled proxy peers. An overly broad range
# allows clients to spoof their source address.
# Example: TRUSTED_PROXY_CIDRS=192.0.2.0/24,127.0.0.1/8,::1/128
TRUSTED_PROXY_CIDRS=127.0.0.1/8,::1/128

# --- Playwright browser tools ---
# Set to false or 0 to disable all browser routes, MCP entries, and Chromium startup.
STELLARA_PLAYWRIGHT_ENABLED=true
# Global concurrent browser-session limit. Each session commonly uses 200-400 MB RAM.
STELLARA_PLAYWRIGHT_MAX_SESSIONS=3
# Concurrent browser-session limit per user.
STELLARA_PLAYWRIGHT_MAX_SESSIONS_PER_USER=1
